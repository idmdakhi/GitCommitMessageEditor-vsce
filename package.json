{
  "name": "gitcme",
  "displayName": "Gitcme » Git Commit Message Editor",
  "description": "Modern commit message editor with configurable form, IntelliSense, and AI draft",
  "version": "1.5.0",
  "publisher": "idmdakhi",
  "keywords": [
    "git",
    "commit",
    "message",
    "editor",
    "conventional-commits",
    "gitmoji",
    "ai",
    "copilot",
    "template",
    "form",
    "vscode",
    "scm",
    "productivity",
    "commit-message",
    "semantic-commit"
  ],
  "author": "",
  "homepage": "https://github.com/idmdakhi/GitCommitMessageEditor-vsce#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idmdakhi/GitCommitMessageEditor-vsce.git"
  },
  "bugs": {
    "url": "https://github.com/idmdakhi/GitCommitMessageEditor-vsce/issues"
  },
  "directories": {
    "assets": "assets",
    "doc": "docs",
    "schemas": "schemas",
    "src": "src",
    "templates": "templates",
    "tests": "tests"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:gitCommitMessageEditor.open",
    "onCommand:gitCommitMessageEditor.openSettings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "commit-message-template.json",
        "url": "./schemas/v1-template.schema.json"
      },
      {
        "fileMatch": "/templates/*.json",
        "url": "./schemas/v1-template.schema.json"
      },
      {
        "fileMatch": "/.vscode/commit-templates/*.json",
        "url": "./schemas/v1-template.schema.json"
      }
    ],
    "commands": [
      {
        "command": "gitCommitMessageEditor.open",
        "title": "Git Commit Message Editor: Open Editor",
        "icon": "$(edit)"
      },
      {
        "command": "gitCommitMessageEditor.openInNewTab",
        "title": "Git Commit Message Editor: Open in New Tab"
      },
      {
        "command": "gitCommitMessageEditor.openSettings",
        "title": "Git Commit Message Editor: Open Settings Page"
      },
      {
        "command": "gitCommitMessageEditor.openConfigEditor",
        "title": "Git Commit Message Editor: Configure Template"
      },
      {
        "command": "gitCommitMessageEditor.createProjectConfig",
        "title": "Git Commit Message Editor: Create Repo Config File"
      },
      {
        "command": "gitCommitMessageEditor.amendLast",
        "title": "Git Commit Message Editor: Amend Last Commit"
      },
      {
        "command": "gitCommitMessageEditor.undoLastInsert",
        "title": "Git Commit Message Editor: Undo Last Insert"
      },
      {
        "command": "gitCommitMessageEditor.openAsGitEditor",
        "title": "Git Commit Message Editor: Open as Git Editor (COMMIT_EDITMSG)",
        "icon": "$(edit)"
      },
      {
        "command": "gitCommitMessageEditor.applyGitEditorMessage",
        "title": "Git Commit Message Editor: Apply Git Editor Message",
        "icon": "$(check)"
      },
      {
        "command": "gitCommitMessageEditor.closeGitEditor",
        "title": "Git Commit Message Editor: Close Git Editor",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitCommitMessageEditor.open",
          "group": "navigation",
          "when": "scmProvider == git && gitcme.scmTitleCommand == 'open'"
        },
        {
          "command": "gitCommitMessageEditor.openAsGitEditor",
          "group": "navigation",
          "when": "scmProvider == git && gitcme.scmTitleCommand == 'openAsGitEditor'"
        }
      ],
      "commandPalette": [
        {
          "command": "gitCommitMessageEditor.open"
        },
        {
          "command": "gitCommitMessageEditor.openInNewTab"
        },
        {
          "command": "gitCommitMessageEditor.openSettings"
        },
        {
          "command": "gitCommitMessageEditor.openConfigEditor"
        },
        {
          "command": "gitCommitMessageEditor.createProjectConfig"
        },
        {
          "command": "gitCommitMessageEditor.amendLast"
        },
        {
          "command": "gitCommitMessageEditor.undoLastInsert"
        },
        {
          "command": "gitCommitMessageEditor.openAsGitEditor"
        },
        {
          "command": "gitCommitMessageEditor.applyGitEditorMessage"
        },
        {
          "command": "gitCommitMessageEditor.closeGitEditor"
        }
      ]
    },
    "configuration": {
      "title": "Git Commit Message Editor",
      "properties": {
        "gitCommitMessageEditor.types": {
          "type": "array",
          "default": [],
          "description": "Allowed values for the type field"
        },
        "gitCommitMessageEditor.scopes": {
          "type": "array",
          "default": [],
          "description": "Saved scopes (auto-added when you create a new scope)"
        },
        "gitCommitMessageEditor.autoFillSignedOffBy": {
          "type": "boolean",
          "default": false,
          "description": "Auto-fill Signed-off-by from git config user.name/user.email"
        },
        "gitCommitMessageEditor.autoGitmoji": {
          "type": "boolean",
          "default": false,
          "description": "Automatically select the emoji matching the Type (enable/disable)"
        },
        "gitCommitMessageEditor.enableStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show status in VS Code status bar"
        },
        "gitCommitMessageEditor.detectIssueFromBranch": {
          "type": "boolean",
          "default": true,
          "description": "Detect issue number from the current branch name (e.g. JIRA-123 or feature/456)"
        },
        "gitCommitMessageEditor.maxSubjectLength": {
          "type": "number",
          "default": 72,
          "description": "Recommended maximum subject length"
        },
        "gitCommitMessageEditor.maxLineLength": {
          "type": "number",
          "default": 100,
          "description": "Maximum line length in body before a warning"
        },
        "gitCommitMessageEditor.rememberFrequentValues": {
          "type": "boolean",
          "default": true,
          "description": "Show frequent type/scope values as clickable chips"
        },
        "gitCommitMessageEditor.showRecentCommits": {
          "type": "boolean",
          "default": true,
          "description": "Show recent commits for quick form fill"
        },
        "gitCommitMessageEditor.recentCommitsMaxItems": {
          "type": "number",
          "default": 12,
          "description": "Maximum number of recent commits shown"
        },
        "gitCommitMessageEditor.emojiPrefix": {
          "type": "boolean",
          "default": false,
          "description": "Prefix the message with a Gitmoji by default"
        },
        "gitCommitMessageEditor.keepAfterSave": {
          "type": "boolean",
          "default": true,
          "description": "Keep the editor tab open after inserting into Source Control"
        },
        "gitCommitMessageEditor.autoApplyGitEditor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically apply the commit message to Source Control when saving the Git Editor (COMMIT_EDITMSG)"
        },
        "gitCommitMessageEditor.defaultEditorMode": {
          "type": "string",
          "enum": [
            "form",
            "freeform"
          ],
          "default": "form",
          "description": "Default editor mode when opening the commit message editor. 'form' shows the structured form, 'freeform' shows a single textarea."
        },
        "gitCommitMessageEditor.scmTitleCommand": {
          "type": "string",
          "enum": [
            "open",
            "openAsGitEditor"
          ],
          "default": "open",
          "description": "Which command to show in the Source Control title bar. 'open' shows the standard editor, 'openAsGitEditor' shows the Git Editor (COMMIT_EDITMSG) mode."
        },
        "gitCommitMessageEditor.rememberFrequentTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show frequent Type values as clickable chips"
        },
        "gitCommitMessageEditor.rememberFrequentScopes": {
          "type": "boolean",
          "default": true,
          "description": "Show frequent Scope values as clickable chips"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "rm -rf out/",
    "compile": "npm run check-types && npm run bundle -- --production",
    "check-types": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "sinon": "^17.0.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
